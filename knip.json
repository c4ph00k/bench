{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["gitleaks"],
  "workspaces": {
    ".": {
      "entry": ["e2e/**/*.spec.ts", "e2e/tools/*.mjs", "scripts/*.mjs"],
      "project": ["e2e/**", "scripts/**"]
    },
    "web": {
      "entry": ["src/*/main.tsx", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**"]
    },
    "server": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**", "test/**"]
    }
  }
}
