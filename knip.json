{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "eslint.config.js",
        "scripts/*.mjs",
        "playwright.config.ts",
        "e2e/global-setup.ts",
        "e2e/**/*.spec.ts",
        "e2e/tools/*.mjs"
      ],
      "project": ["e2e/**", "scripts/**"]
    },
    "web": {
      "entry": ["src/*/main.tsx", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**"]
    },
    "server": {
      "entry": ["src/index.ts", "vitest.config.ts", "test/**/*.test.ts"],
      "project": ["src/**", "test/**", "vitest.config.ts"]
    }
  }
}
