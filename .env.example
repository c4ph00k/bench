# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed - it holds the real connection string and secret.
# This example holds placeholders only, so it is safe to track.

# Postgres connection string the server uses for all four databases.
DATABASE_URL=postgres://bench:bench@localhost:5432/bench

# Secret used to sign and verify session JWTs. Use a long random value.
JWT_SECRET=change-me

# Lifetime of a session token, in seconds.
JWT_TTL=1800

# Port the API listens on.
PORT=8100

# First-run bootstrap: the tenant owner created when the database is empty.
SEED_EMAIL=marco@example.com
SEED_PASSWORD=bench

NODE_ENV=development