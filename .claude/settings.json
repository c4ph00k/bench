{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/stop-lint.mjs\"",
            "statusMessage": "Linting before the turn ends",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
